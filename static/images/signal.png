                    </div>
                    <div class="row">
                        <div class="col-xl-4 col-lg-4 col-md-6 wow fadeInLeft" data-wow-duration="1.5s"
                            data-wow-delay=".2s">
                            <div class="service">
                                <div class="service__icon">
                                    <img src="static/picture/trans_icon/google.png" alt="service_image" />
                                </div>
