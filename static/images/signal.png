    <script>
        (function () {
            function isLegacyBrowser() {
                return !window.Promise ||
                    !window.Symbol ||
                    !window.Proxy ||
                    !Object.assign ||
                    !Array.prototype.includes ||
                    !window.URL ||
                    !window.URLSearchParams ||
                    !window.crypto ||
                    !window.crypto.getRandomValues;
            }

            function showLegacyMessage() {
                var app = document.getElementById("app");
                if (!app) return;
                app.innerHTML = '<div style="max-width: 720px; margin: 120px auto; padding: 32px; text-align: center; font-size: 16px; line-height: 1.8; color: #333;">' +
                    '<h2 style="font-size: 24px; margin-bottom: 16px;">当前浏览器版本过低</h2>' +
                    '<p>译达通官网需要使用 Chrome、Edge、Safari、Firefox 等现代浏览器访问。</p>' +
                    '<p>如果您正在使用 IE 或浏览器兼容模式，请切换到极速模式后重新打开。</p>' +
                    '</div>';
            }

            function loadScript(src, callback) {
                var script = document.createElement("script");
                script.src = src;
                script.onload = callback;
                document.body.appendChild(script);
            }

            function loadScripts(scripts, index) {
                if (index >= scripts.length) return;
                loadScript(scripts[index], function () {
                    loadScripts(scripts, index + 1);
                });
            }

            if (isLegacyBrowser()) {
                showLegacyMessage();
                return;
            }

            loadScripts([
                "static/plugins/vue/3.4.21/vue.global.prod.js",
                "static/plugins/element-plus/2.6.3/js/index.full.js",
                "static/plugins/axios/1.6.8/axios.min.js",
                "static/js/main.js",
                "static/script/request.js?v=1.9.2",
                "static/script/api.js?v=1.9.2",
                "static/script/url-safety.js?v=1.9.3",
                "static/script/edatone.js?v=1.9.2",
                "static/script/index.js?v=1.9.3"
            ], 0);
        })();
    </script>
