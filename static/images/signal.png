            <!-- === HOME-2 USER EXPERIENCE AREA START  === -->
            <div class="experience_area">
                <div class="container">
                    <div class="section_title_wrapper text-center mb-70 mt-50">
                        <h2 class="section-title">丰富的翻译渠道</h2>
                        <p style="text-align: center">
                            支持市面上主流的六大翻译渠道，提供用户更多更全面的选择
