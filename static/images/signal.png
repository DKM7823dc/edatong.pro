<body>
    <div id="app" v-cloak>
        <!-- HEADER START -->
        <header>
            <div id="header-sticky" class="header-area header-area-white transparent-header pb-10 fixed" :style="{background:
        scrollTop >= 2
          ? 'linear-gradient(-120deg, #5e54fd 1%, #5d45e5 100%)'
          : 'none'}">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-xl-2 col-lg-2 col-md-4 col-10 d-flex align-items-center">
                            <div class="logo">
                                <a href="index.html"><img src="static/images/logo_dark.png" width="90" /></a>
                            </div>
                        </div>
                        <div class="col-xl-10 col-lg-10 col-md-7 col-8 d-none d-md-block">
                            <template v-if="userInfo.token && userInfo.userData?.name">
                                <div class="f-right d-none d-sm-none d-md-block d-md-none d-lg-block"
                                    style="padding-top: 28px">
                                    <el-dropdown @command="handleCommand" popper-class="user-info-popper">
                                        <span class="el-dropdown-link">
                                            <i class="iconfont icon-user-info"></i>
                                            {{ userInfo.userData.name}}<i
                                                class="iconfont icon-arrow-down user-info-arrow-down"></i>
                                        </span>
                                        <template #dropdown>
                                            <el-dropdown-menu>
                                                <el-dropdown-item command="user"><i
                                                        class="iconfont icon-user-info"></i>个人中心</el-dropdown-item>
                                                <el-dropdown-item command="logout"><i
                                                        class="iconfont icon-logout"></i>退出登录</el-dropdown-item>
                                            </el-dropdown-menu>
                                        </template>
                                    </el-dropdown>
                                </div>
                            </template>
                            <template v-else>
                                <div class="f-right d-none d-sm-none d-md-block d-md-none d-lg-block"
                                    style="padding-top: 22px">
                                    <a class="btn ed-btn btn-white" href="javascript:void(0)"
                                        data-url="signup.html?path=index.html" data-name="topmenu-signup"
                                        data-content="顶部菜单-免费注册"><i class="iconfont icon-signup"></i>免费注册
                                        <span class="tips">新用户赠送30000字符</span>
                                    </a>
                                    <a class="btn ed-btn btn-white" href="javascript:void(0)"
                                        data-url="login.html?path=index.html" data-name="topmenu-login"
                                        data-content="顶部菜单-立即登录" style="margin-left: 10px"><i
                                            class="iconfont icon-user"></i>立即登录</a>
                                </div>
                            </template>
                            <div class="main-menu colormenu d-block">
                                <nav id="mobile-menu">
                                    <ul>
                                        <li><a href="javascript:void(0)" data-url="index.html" data-name="topmenu-index"
